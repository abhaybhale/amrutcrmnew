# ==========================================================================
# Amrut CRM Enterprise — environment configuration
# Copy this file to .env.local and fill in the values. See SETUP.md for the
# full walkthrough (Google Cloud Console steps, Firebase Functions deploy).
# All variables here are prefixed VITE_ because Vite only exposes
# VITE_-prefixed vars to browser code — never put secret API keys here.
# ==========================================================================

# --------------------------------------------------------------------------
# Google OAuth (real Gmail + Calendar sync)
# --------------------------------------------------------------------------
# OAuth 2.0 Client ID (Web application type) from Google Cloud Console →
# APIs & Services → Credentials. This project already ships with a client ID
# in firebase-applet-config.json ("oAuthClientId") which is used as a
# fallback if this is left blank — but you must still enable the Gmail API
# and Google Calendar API on that same Google Cloud project, and add your
# app's URL (e.g. http://localhost:3000 and your production domain) as an
# Authorized JavaScript origin. See SETUP.md.
VITE_GOOGLE_OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# --------------------------------------------------------------------------
# Claude AI backend (aiProxy Firebase Function)
# --------------------------------------------------------------------------
# The URL of the deployed `aiProxy` Cloud Function (see /functions). The
# Anthropic API key itself lives ONLY server-side as a Firebase secret —
# never put it in this file or any VITE_ variable. Leave this blank to run
# the app with AI features gracefully disabled.
# Example: https://us-central1-<your-project-id>.cloudfunctions.net/aiProxy
VITE_AI_FUNCTION_URL=""

# --------------------------------------------------------------------------
# Real Firebase Authentication — account provisioning functions
# --------------------------------------------------------------------------
# Every signed-in user's Firebase Auth uid is set (via these two Cloud
# Functions, using the Admin SDK) to match their CRM `usr_xxx` Firestore
# document id. Both live in /functions alongside aiProxy — deploy all three
# together with `firebase deploy --only functions`. See SETUP.md §5.
#
# activateInvitedUser: lets a newly invited/imported user choose their
# permanent password on first sign-in (the "First-Time Setup" flow).
VITE_ACTIVATE_USER_FUNCTION_URL=""
VITE_PROVISION_USER_FUNCTION_URL=""
# provisionDemoData: one-time, idempotent bulk-creation of Firebase Auth
# accounts for the seeded demo personas, so the sign-in screen's "Instant
# Demo Access" buttons work against a fresh Firebase project with no manual
# setup. Safe to leave configured permanently — it never overwrites an
# existing account.
VITE_PROVISION_DEMO_FUNCTION_URL=""

# --------------------------------------------------------------------------
# APP_URL: used for self-referential links (kept from the original AI
# Studio scaffold; harmless to leave as-is for local dev).
# --------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# Keep false in production. Enable only for a controlled, one-time seed of a
# new database while signed in as an administrator.
VITE_ALLOW_DATABASE_SEEDING="false"
